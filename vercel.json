{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express"
    },
    "web": {
      "root": "web",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/(.*)",
          "destination": "/index.html"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(features|for|about|contact|privacy|terms|blog|rss\\.xml|sitemap\\.xml|robots\\.txt|llms\\.txt)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(about|contact|privacy|terms)/",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(features|for|blog|media)/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
