{
  "expo": {
    "name": "KARO",
    "slug": "taskpro",
    "scheme": "taskpro",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "in.salestracker.taskpro",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "in.salestracker.taskpro",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-bg.png",
        "monochromeImage": "./assets/adaptive-icon-mono.png",
        "backgroundColor": "#032D60"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "taskpro-self.vercel.app",
              "pathPrefix": "/join/"
            },
            {
              "scheme": "https",
              "host": "taskpro-self.vercel.app",
              "pathPrefix": "/tasks/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-light.png",
          "imageWidth": 132,
          "resizeMode": "contain",
          "backgroundColor": "#F3F3F3",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#001639"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0176D3",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "KARO uses the camera to take photos you attach to a task, and your profile photo.",
          "photosPermission": "KARO lets you choose photos from your gallery to attach to a task, or as your profile photo.",
          "microphonePermission": "KARO uses the microphone to record voice notes on tasks."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "KARO uses the microphone to record voice notes on tasks."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withBuildTuning",
      "expo-asset"
    ],
    "extra": {
      "apiUrl": "https://taskpro-self.vercel.app"
    }
  }
}
